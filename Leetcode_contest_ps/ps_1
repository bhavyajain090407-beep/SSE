class Solution {
    public int[] maxProductPair(int[] nums, int target) {
        int real = 0;
        int max = Integer.MIN_VALUE;
        int[] ans = {-1,-1};
        for(int i=0 ; i<nums.length ; i++){
            for(int j=i+1 ; j<nums.length ; j++){
                if((nums[i]+nums[j])==target && nums[i]!=nums[j]){
                    real = nums[i]*nums[j];
                    if(real>max){
                        max = real;
                        if(nums[i]>nums[j]){
                            ans[0] = i;
                            ans[1] = j;
                        }
                        else{
                            ans[0] = j;
                            ans[1] = i;
                        }
                    }
                }
            }
        }
        return ans;
    }
}