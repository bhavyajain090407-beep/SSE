inport java.util.*;
public class Solution {
    public int reverseBits(int n) {
        int bitmask = 1;
        int a = 0;
        int b = 0;
        int value = 0;
        int c = 31;
        for(int i=0 ; i<32 ; i++){
            a = n&bitmask;
            bitmask = bitmask<<(1);
            a = a>>i;
            value = value + (a<<c);
            c--;
        }
        return value;
    }
}