class Solution {
    public int[] getConcatenation(int[] nums) {
        int ans[] = new int[2*nums.length];
        for(int i = 0 ; i<nums.length ; i++){
            ans[i]=nums[i];
        }
        for(int m = nums.length ; m<2*nums.length ; m++){
            ans[m]=nums[m-nums.length];
        }
        return ans;
    }
}