class Solution {
    public int removeElement(int[] nums, int val) {
        int m = 0;
        int arg[] = new int[nums.length];
        for(int i = 0 ; i<nums.length ; i++){ 
            if(nums[i]!=val){
                arg[m]=nums[i];                
                m++;
            }
        }
        for(int i = 0 ; i<nums.length ; i++){
            nums[i]=arg[i];
        }
        return m;
    }
}