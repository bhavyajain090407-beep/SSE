class Solution {
    public int[] twoSum(int[] nums, int target) {
       int num[] = null;
        for(int i = 0 ; i<nums.length ; i++){
            for(int m=i+1 ; m<nums.length ; m++){
                if((nums[i]+nums[m]==target)){
                    num = new int[]{i,m};
                    return num;
                }
            }
        }
        return num;
    }
}