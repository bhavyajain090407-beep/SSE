class Solution {
    public int maxProduct(int[] nums) {
        int max_value1 = Integer.MIN_VALUE;
        int max_value2 = Integer.MIN_VALUE;
        int a = 0;
        int b = 0;
        for(int i = 0 ; i<nums.length ; i++){
            if(max_value1<nums[i]){
                a = i;
                max_value1 = nums[i];
            }
        }
        nums[a]=-1;
        for(int j = 0 ; j<nums.length ; j++){
            if(max_value2<nums[j]){
                b = j;
                max_value2 = nums[j];
            }
        }
        return (max_value1-1)*(max_value2-1);
    }
}