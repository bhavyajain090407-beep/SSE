class Solution {
    public int[] singleNumber(int[] nums) {
        int xorAll = 0;
        for (int i = 0; i < nums.length; i++) {
            xorAll = xorAll ^ nums[i];
        }
        int diffBit = xorAll & (-xorAll);
        int a = 0, b = 0;
        for (int i = 0; i < nums.length; i++) {
            if ((nums[i] & diffBit) != 0) {
                a = a ^ nums[i];
            } else {
                b = b ^ nums[i];
            }
        }
        return new int[]{a, b};
    }
}