class Solution {
    public void sortColors(int[] nums) {
        int a = 0;
        int b = 0;
        int c = 0;
        for(int i = 0 ; i<nums.length ; i++){
            if(nums[i]==0){
                a++;
            }
            else if(nums[i]==1){
                b++;
            }
            else if(nums[i]==2){
                c++;
            }
        }
        for(int m = 0 ; m<nums.length ; m++){
            if(m<a){
                nums[m]=0;
            }
            else if(m<a+b){
                nums[m]=1;
            }
            else if(m<a+b+c){
                nums[m]=2;
            }
        }
    }
}