class Solution {
    public int singleNumber(int[] nums) {
        int[] bitCount = new int[32];
        for (int j = 0; j < nums.length; j++) {
            for (int i = 0; i < 32; i++) {
                bitCount[i] += (nums[j] >> i) & 1;
            }
        }
        int result = 0;
        for (int i = 0; i < 32; i++) {
            if (bitCount[i] % 3 != 0) {
                result |= (1 << i);
            }
        }
        return result;
    }
}