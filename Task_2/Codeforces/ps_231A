import java.util.*;
 
public class Main {
    public static int answer(int a , int b , int c){
        if(a==1 && b==1){
            return 1;
        }
        else if(b==1 && c==1){
            return 1;
        }
        else if(c==1 && a==1){
            return 1;
        }
        return 0;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int ans = 0;
        while (n-- > 0) {
            int a = sc.nextInt();
            int b = sc.nextInt();
            int c = sc.nextInt();
            if(answer(a, b, c)==1){
                ans++;
            }
        }
        System.out.println(ans);
    }
}