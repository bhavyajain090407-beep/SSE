class Solution {
    public void rotate(int[] nums, int k) {
        k = k % nums.length;
        int[] arr = new int[nums.length];
        for (int i = 0; i < k; i++) {
            arr[i] = nums[nums.length - k + i];
        }
        for (int b = k; b < nums.length; b++) {
            arr[b] = nums[b - k];
        }
    }
}